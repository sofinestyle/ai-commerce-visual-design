generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  platformId          String
  language            String
  status              String
  coverMediaId        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  platform            Platform            @relation(fields: [platformId], references: [id])
  coverMedia          Media?              @relation("ProjectCoverMedia", fields: [coverMediaId], references: [id])
  products            Product[]
  media               Media[]             @relation("ProjectMedia")
  workflows           Workflow[]
  tasks               Task[]
  generationHistories GenerationHistory[]
}

model Product {
  id                  String              @id @default(cuid())
  projectId           String
  brandId             String
  platformId          String
  name                String
  sku                 String
  category            String
  language            String
  description         String?
  coverMediaId        String?
  status              String
  tags                Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  project             Project             @relation(fields: [projectId], references: [id])
  brand               Brand               @relation(fields: [brandId], references: [id])
  platform            Platform            @relation(fields: [platformId], references: [id])
  coverMedia          Media?              @relation("ProductCoverMedia", fields: [coverMediaId], references: [id])
  media               Media[]             @relation("ProductMedia")
  tasks               Task[]
  generationHistories GenerationHistory[]
}

model Media {
  id              String    @id @default(cuid())
  projectId       String
  productId       String?
  name            String
  filename        String
  type            String
  mimeType        String
  storagePath     String
  hash            String
  thumbnail       String?
  previewImage    String?
  width           Int?
  height          Int?
  fileSize        String?
  status          String
  tags            Json
  source          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  project         Project   @relation("ProjectMedia", fields: [projectId], references: [id])
  product         Product?  @relation("ProductMedia", fields: [productId], references: [id])
  projectCoverFor Project[] @relation("ProjectCoverMedia")
  productCoverFor Product[] @relation("ProductCoverMedia")
}

model Workflow {
  id                  String              @id @default(cuid())
  projectId           String
  name                String
  description         String?
  status              String
  workflowJson        Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  project             Project             @relation(fields: [projectId], references: [id])
  tasks               Task[]
  generationHistories GenerationHistory[]
}

model PromptTemplate {
  id                  String              @id @default(cuid())
  name                String
  category            String
  platformId          String
  language            String
  model               String
  systemPrompt        String
  userPrompt          String
  negativePrompt      String
  variables           Json
  tags                Json
  version             String
  status              String
  favorite            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  platform            Platform            @relation(fields: [platformId], references: [id])
  tasks               Task[]
  generationHistories GenerationHistory[]
}

model GenerationHistory {
  id               String         @id @default(cuid())
  projectId        String
  productId        String
  workflowId       String
  promptTemplateId String
  taskId           String
  model            String
  prompt           String
  negativePrompt   String
  size             String
  quality          String
  seed             Int?
  temperature      Float?
  steps            Int?
  cost             Float?
  duration         Int?
  status           String
  resultCount      Int            @default(0)
  outputMediaIds   Json
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  project          Project        @relation(fields: [projectId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  workflow         Workflow       @relation(fields: [workflowId], references: [id])
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id])
  task             Task           @relation(fields: [taskId], references: [id])
}

model Task {
  id                  String              @id @default(cuid())
  projectId           String
  productId           String
  workflowId          String
  promptTemplateId    String
  taskType            String
  model               String
  status              String
  progress            Int
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  duration            Int?
  errorMessage        String?
  resultCount         Int                 @default(0)
  deletedAt           DateTime?
  project             Project             @relation(fields: [projectId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  workflow            Workflow            @relation(fields: [workflowId], references: [id])
  promptTemplate      PromptTemplate      @relation(fields: [promptTemplateId], references: [id])
  generationHistories GenerationHistory[]
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  code        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]
}

model Platform {
  id              String           @id @default(cuid())
  name            String
  code            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  projects        Project[]
  products        Product[]
  promptTemplates PromptTemplate[]
}
